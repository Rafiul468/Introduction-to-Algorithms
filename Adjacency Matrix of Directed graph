#include <bits/stdc++.h>
using namespace std;

int main() {
    int n,e;
    cin>>n>>e;

    int adj_mat [n][n];

    //loop cara zerro korar short-curt technic.
    memset(adj_mat,0,sizeof(adj_mat));    //1.kar memory set korte cacci, 2. value, 3. koto-gula rakte cacci.

    for(int i=0; i<n; i++)  //diagonal value = 1.
        for(int j=0; j<n;j++)
            if(i==j)
                adj_mat[i][j]=1;
    while(e--) 
    {
        int a,b;
        cin>>a>>b;
        adj_mat[a][b] = 1;
    }
     for(int i=0; i<n; i++)
    {
        for(int j = 0; j<n; j++)
        {
            cout<<adj_mat[i][j]<<" ";
        }
        cout<<endl;
    }
    return 0;
}
